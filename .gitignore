### --- CLion / JetBrains Specific ---
.idea/
# Si quieres compartir la configuración de estilo de código o diccionarios con tu equipo, 
# puedes descomentar las siguientes líneas:
# !.idea/codeStyles/
# !.idea/dictionaries/

# Archivos de usuario locales (guardan la disposición de las ventanas, pestañas abiertas, etc.)
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/usageView.xml
.idea/**/azure.xml
.idea/**/shelf/

# Archivos temporales de CMake generados por CLion (MODIFICADO PARA LAS EXCEPCIONES)
cmake-build-debug/*
!cmake-build-debug/Archivos/
!cmake-build-debug/Reportes/
cmake-build-debug/Reportes/*

.cmake/

### --- C / C++ Compilation Artifacts ---
# Archivos objeto y librerías compiladas
*.o
*.obj
*.a
*.lib
*.so
*.dylib

# Ejecutables finales (puedes añadir nombres específicos si no tienen extensión)
*.exe
*.out
*.app

### --- OS Specific (Opcional) ---
.DS_Store
Thumbs.db
